# Stage 1: Build the React static assets
FROM node:20-alpine AS builder

WORKDIR /app

# Optional build argument for backend API URL
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

COPY frontend/Cluster-Agent/package*.json ./
RUN npm ci

COPY frontend/Cluster-Agent/ ./
RUN npm run build

# Stage 2: Serve static files with Nginx
FROM nginx:alpine

COPY frontend/Cluster-Agent/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
